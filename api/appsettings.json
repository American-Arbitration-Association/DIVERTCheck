{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Schema": "your_db_schema",
    "CommandTimeoutSeconds": 30
  },
  "AzureMonitor": {
    "ConnectionString": "",
    "SamplingRatio": 1.0,
    "TraceOpenAIPayloads": false,
    "TracePayloadMaxChars": 8000
  },
  "AzureStorage": {
    "StorageConnectionString-DivertCheck": "",
    "ContainerName": "your_container_name"
  },
  "Smtp": {
    "Username": "your_smtp_username",
    "Password": "",
    "Host": "your_smtp_host",
    "Port": 25,
    "EnableSsl": true
  },
  "ConnectionStrings": {
    "DivertCheck": {
      "Connection": ""
    }
  },
  "AzureOpenAI": {
    "ApiKeyDivertCheck": "",
    "DefaultModelName": "gpt-5.4-mini",
    "DefaultReasoningEffort": "medium",
    "CaseReviewMaxOutputTokens": 120000,
    "CaseReviewCitationCorrectionAttempts": 2,
    "CaseReviewSummaryMaxOutputTokens": 1200,
    "PromptSuggestionMaxOutputTokens": 12000,
    "VisionExtractionMaxCompletionTokens": 12000,
    "FilesEndpoint": "https://your_openai_resource.openai.azure.com/openai/v1/files",
    "VectorStoresEndpoint": "https://your_openai_resource.openai.azure.com/openai/v1/vector_stores",
    "ResponsesEndpoint": "https://your_openai_resource.openai.azure.com/openai/v1/responses",
    "ChatCompletionsEndpoint": "https://your_openai_resource.openai.azure.com/openai/v1/chat/completions"
  },
  "DocumentProcessing": {
    "MaxParallelVisionCalls": 2,
    "VisionRetryCount": 2,
    "EvidenceChunkMaxCharacters": 45000,
    "ChunkOverlap": 1000,
    "MaxParallelEvidenceCalls": 3,
    "EvidenceRetryCount": 2,
    "EvidenceMaxOutputTokens": 6000,
    "FileSearchMaxResults": 20
  },
  "AiJobProcessing": {
    "StaleProcessingTimeoutSeconds": 600,
    "JobTimeoutSeconds": 900
  },
  "AzureKeyVault": "https://your_keyvault_name.vault.azure.net/",
  "Jwt": {
    "Issuer": "divertCheck-api",
    "Audience": "divertCheck-client",
    "ExpiresMinutes": 3600
  },
  "AllowedHosts": "*"
}
