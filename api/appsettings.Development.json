{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5174",
      "https://localhost:5174",
      "http://your_dev_app_host:9071",
      "https://your_dev_app_host:9071"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"                                                             
    }
  },
  "Database": {
    "Schema": "your_dev_db_schema",
    "CommandTimeoutSeconds": 30
  },
  "AzureMonitor": {
    "ConnectionString": "",
    "TraceOpenAIPayloads": false,
    "TracePayloadMaxChars": 8000
  },
  "Smtp": {
    "Username": "your_smtp_username",
    "Password": "",
    "Host": "your_smtp_host",
    "Port": 25,
    "EnableSsl": true
  },
  "ConnectionStrings": {
    "DivertCheck": {
      "Connection": ""
    }
  },
  "AzureOpenAI": {
    "ApiKeyDivertCheck": "",
    "DefaultModelName": "gpt-5.4-mini",
    "DefaultReasoningEffort": "medium",
    "CaseReviewMaxOutputTokens": 120000,
    "CaseReviewCitationCorrectionAttempts": 2,
    "CaseReviewSummaryMaxOutputTokens": 1200,
    "PromptSuggestionMaxOutputTokens": 12000,
    "VisionExtractionMaxCompletionTokens": 12000,
    "FilesEndpoint": "https://your_azure_openai_resource.openai.azure.com/openai/v1/files",
    "VectorStoresEndpoint": "https://your_azure_openai_resource.openai.azure.com/openai/v1/vector_stores",
    "ResponsesEndpoint": "https://your_azure_openai_resource.openai.azure.com/openai/v1/responses",
    "ChatCompletionsEndpoint": "https://your_azure_openai_resource.openai.azure.com/openai/v1/chat/completions"
  },
  "DocumentProcessing": {
    "MaxParallelVisionCalls": 2,
    "VisionRetryCount": 2,
    "EvidenceChunkMaxCharacters": 45000,
    "ChunkOverlap": 1000,
    "MaxParallelEvidenceCalls": 3,
    "EvidenceRetryCount": 2,
    "EvidenceMaxOutputTokens": 6000,
    "FileSearchMaxResults": 20
  },
  "AzureKeyVault": "https://your_dev_keyvault_name.vault.azure.net/",
  "NLog": {
    "internalLogLevel": "Info",
    "internalLogFile": "C:\\Temp\\DIVERTCheck\\internal-nlog.txt",
    "throwConfigExceptions": true,
    "autoReload": true,
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "C:\\Temp\\DIVERTCheck\\console.log",
        "layout": "${date} | ${level:uppercase=true:padding=5} | ${logger} | ${callsite} | ${callsite-linenumber} | ${message} ${exception:format=toString,Data} ${all-event-properties}",
        "archiveFileName": "C:\\Temp\\DIVERTCheck\\archive\\console.{#}.log"
      },
      "logerrorfile": {
        "type": "File",
        "fileName": "C:\\Temp\\DIVERTCheck\\error.log",
        "layout": "${date} | ${level:uppercase=true:padding=5} | ${logger} | ${callsite} | ${callsite-linenumber} | ${message} ${exception:format=toString,Data} ${all-event-properties}",
        "archiveFileName": "C:\\Temp\\DIVERTCheck\\archive\\error.{#}.log"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logfile"
      },
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "logerrorfile"
      }
    ]
  }
}